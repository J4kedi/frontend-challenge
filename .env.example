# Copie para .env.local se quiser sobrescrever algum valor localmente.

# Liga a camada de mocks (MSW + Socket.IO simulado). O build de demonstração
# publicado usa true (ver .env.production); sem backend real, false só serve
# para apontar o app para uma API de verdade.
VITE_ENABLE_MOCKS=true

# Base da API REST e endereço do Socket.IO. Com mocks ligados, os dois são
# interceptados no navegador e nunca saem para a rede.
VITE_API_URL=/api
VITE_SOCKET_URL=wss://realtime.kurio.mock

# Mostra o painel flutuante de cenários de mock (canto inferior esquerdo).
VITE_MOCK_PANEL=true

# Só para scripts/figma-extract.mjs (token pessoal com escopo file_content:read).
FIGMA_TOKEN=
